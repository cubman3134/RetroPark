+</Project>
diff --git a/Source/Core/DolphinNoGUI/rp_dolphin.cpp b/Source/Core/DolphinNoGUI/rp_dolphin.cpp
new file mode 100644
index 0000000000..4813d9a3e7
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/rp_dolphin.cpp
@@ -0,0 +1,128 @@
+// RetroPark: dolphin_present.dll — an in-process vehicle that boots Dolphin headless with the
+// external-present path (renders into RetroPark's imported VkImage) and exposes a tiny C API the
+// RetroPark host LoadLibrary's. Not part of upstream Dolphin. (Captured in dolphin-external-present.patch.)
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <thread>
+
+#include "Common/MsgHandler.h"
+#include "Common/WindowSystemInfo.h"
+#include "Common/Config/Config.h"
+
+#include "Core/Boot/Boot.h"
+#include "Core/BootManager.h"
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/Core.h"
+#include "Core/Host.h"
+#include "Core/System.h"
+
+#include "UICommon/UICommon.h"
+
+#include "VideoBackends/Vulkan/VulkanContext.h"
+
+// ---- Host_* callbacks required by DolphinLib (headless no-ops). ----
+std::vector<std::string> Host_GetPreferredLocales() { return {}; }
+void Host_PPCSymbolsChanged() {}
+void Host_PPCBreakpointsChanged() {}
+bool Host_UIBlocksControllerState() { return false; }
+void Host_Message(HostMessageID) {}
+void Host_UpdateTitle(const std::string&) {}
+void Host_UpdateDisasmDialog() {}
+void Host_JitCacheInvalidation() {}
+void Host_JitProfileDataWiped() {}
+void Host_RequestRenderWindowSize(int, int) {}
+bool Host_RendererHasFocus() { return true; }
+bool Host_RendererHasFullFocus() { return true; }
+bool Host_RendererIsFullscreen() { return false; }
+bool Host_TASInputHasFocus() { return false; }
+void Host_YieldToUI() {}
+void Host_TitleChanged() {}
+void Host_UpdateDiscordClientID(const std::string&) {}
+bool Host_UpdateDiscordPresenceRaw(const std::string&, const std::string&, const std::string&,
+                                   const std::string&, const std::string&, const std::string&,
+                                   const int64_t, const int64_t, const int, const int)
+{
+  return false;
+}
+std::unique_ptr<GBAHostInterface> Host_CreateGBAHost(std::weak_ptr<HW::GBA::Core>) { return nullptr; }
+
+// ---- The in-process vehicle. ----
+namespace
+{
+std::thread g_host_thread;
+std::atomic<bool> g_running{false};
+
+void HostThread(std::string rom, std::string user_dir)
+{
+  // No modal dialogs (Dolphin's "Warning" panic would block a headless run).
+  Common::SetEnableAlert(false);
+
+  UICommon::SetUserDirectory(user_dir);
+  UICommon::Init();
+
+  // Force the Vulkan backend (its external-present path renders into RetroPark's image).
+  Config::SetBaseOrCurrent(Config::MAIN_GFX_BACKEND, "Vulkan");
+
+  const WindowSystemInfo wsi(WindowSystemType::Headless, nullptr, nullptr, nullptr);
+  UICommon::InitControllers(wsi);
+
+  auto& system = Core::System::GetInstance();
+  auto boot = BootParameters::GenerateFromFile(
+      rom, BootSessionData(std::nullopt, DeleteSavestateAfterBoot::No));
+  if (boot && BootManager::BootCore(system, std::move(boot), wsi))
+  {
+    while (g_running.load(std::memory_order_acquire))
+    {
+      Core::HostDispatchJobs(system);
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    Core::Stop(system);
+    Core::Shutdown(system);
+  }
+
+  UICommon::ShutdownControllers();
+  UICommon::Shutdown();
+}
+}  // namespace
+
+extern "C"
+{
+  // Configure external-present + boot the ROM headless on Vulkan. Returns 0 on success.
+  __declspec(dllexport) int rp_dolphin_boot(const uint8_t* device_uuid, void* image_handle,
+                                            void* timeline_handle, uint32_t width, uint32_t height,
+                                            const char* rom_path, const char* user_dir)
+  {
+    if (g_running.load())
+      return 1;
+    auto& ext = Vulkan::GetRetroParkExternalPresent();
+    ext.enabled = true;
+    std::memcpy(ext.device_uuid, device_uuid, 16);
+    ext.image_handle = image_handle;
+    ext.timeline_handle = timeline_handle;
+    ext.width = width;
+    ext.height = height;
+
+    g_running.store(true, std::memory_order_release);
+    g_host_thread = std::thread(HostThread, std::string(rom_path ? rom_path : ""),
+                                std::string(user_dir ? user_dir : ""));
+    return 0;
+  }
+
+  // The most recent timeline value Dolphin signalled (2*frame) — the host waits on this.
+  __declspec(dllexport) uint64_t rp_dolphin_last_signal()
+  {
+    return Vulkan::GetRetroParkLastSignaledValue().load(std::memory_order_acquire);
+  }
+
+  __declspec(dllexport) void rp_dolphin_stop()
+  {
+    g_running.store(false, std::memory_order_release);
+    if (g_host_thread.joinable())
+      g_host_thread.join();
+  }
+}

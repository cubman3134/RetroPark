+    VkSemaphore consume = VK_NULL_HANDLE;
+    if (vkCreateSemaphore(dev, &sem_info, nullptr, &consume) != VK_SUCCESS)
+    {
+      ERROR_LOG_FMT(VIDEO, "RetroPark: create consume timeline semaphore failed");
+      return false;
+    }
+    VkImportSemaphoreWin32HandleInfoKHR cisi = {};
+    cisi.sType = VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_WIN32_HANDLE_INFO_KHR;
+    cisi.semaphore = consume;
+    cisi.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+    cisi.handle = ext.consume_timeline_handle;  // host retains ownership
+    if (pfnImportSem(dev, &cisi) != VK_SUCCESS)
+    {
+      ERROR_LOG_FMT(VIDEO, "RetroPark: import consume timeline semaphore failed");
+      vkDestroySemaphore(dev, consume, nullptr);
+      return false;
+    }
+    m_ext_consume_timeline = consume;
+  }
+
+  INFO_LOG_FMT(VIDEO, "RetroPark: external present target ready ({}x{}), consume-timeline={}", ext.width,
+               ext.height, m_ext_consume_timeline != VK_NULL_HANDLE);
+  return true;

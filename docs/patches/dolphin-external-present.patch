+  for (u32 i = 0; i < slot_count; ++i)
+  {
+    void* handle = ext.image_handles[i] ? ext.image_handles[i] : (i == 0 ? ext.image_handle : nullptr);
+    if (!handle)
+    {
+      ERROR_LOG_FMT(VIDEO, "RetroPark: external slot {} has no shared handle", i);

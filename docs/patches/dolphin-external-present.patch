+  VkSemaphoreTypeCreateInfo type_info = {};
+  type_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO;
+  type_info.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
+  type_info.initialValue = 0;
+  VkSemaphoreCreateInfo sem_info = {};
+  sem_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+  sem_info.pNext = &type_info;
+  if (vkCreateSemaphore(dev, &sem_info, nullptr, &m_ext_timeline) != VK_SUCCESS)
+  {
+    ERROR_LOG_FMT(VIDEO, "RetroPark: create timeline semaphore failed");
+    return false;
+  }
+  auto pfnImportSem = reinterpret_cast<PFN_vkImportSemaphoreWin32HandleKHR>(
+      vkGetDeviceProcAddr(dev, "vkImportSemaphoreWin32HandleKHR"));
+  if (!pfnImportSem)
+  {
+    ERROR_LOG_FMT(VIDEO, "RetroPark: vkImportSemaphoreWin32HandleKHR not available");
+    return false;
+  }
+  VkImportSemaphoreWin32HandleInfoKHR isi = {};
+  isi.sType = VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_WIN32_HANDLE_INFO_KHR;
+  isi.semaphore = m_ext_timeline;
+  isi.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+  isi.handle = ext.timeline_handle;  // host retains ownership
+  if (pfnImportSem(dev, &isi) != VK_SUCCESS)
+  {
+    ERROR_LOG_FMT(VIDEO, "RetroPark: import timeline semaphore failed");
+    return false;
+  }
+
+  // Import the host's CONSUME timeline when it exported one (slot_count>=2 back-pressure). When absent
+  // (single-image boot path), AcquireNextImage falls back to waiting the produce timeline directly.
+  if (ext.consume_timeline_handle)

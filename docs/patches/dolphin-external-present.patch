+// RetroPark: process-global external-present configuration, set by the in-process host before boot.
+RetroParkExternalPresent& GetRetroParkExternalPresent()
+{
+  static RetroParkExternalPresent s_external_present;
+  return s_external_present;
+}
+
+// RetroPark: query a physical device's UUID (VkPhysicalDeviceIDProperties via properties2).
+static void QueryPhysicalDeviceUUID(VkPhysicalDevice device, u8 out_uuid[VK_UUID_SIZE])
+{
+  VkPhysicalDeviceIDProperties id_props = {};
+  id_props.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES;
+  VkPhysicalDeviceProperties2 props2 = {};
+  props2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
+  props2.pNext = &id_props;
+  vkGetPhysicalDeviceProperties2(device, &props2);
+  std::memcpy(out_uuid, id_props.deviceUUID, VK_UUID_SIZE);
+}
+
+int VulkanContext::FindDeviceIndexByUUID(const GPUList& gpu_list, const u8 uuid[VK_UUID_SIZE])
+{
+  for (size_t i = 0; i < gpu_list.size(); i++)
+  {
+    u8 dev_uuid[VK_UUID_SIZE];
+    QueryPhysicalDeviceUUID(gpu_list[i], dev_uuid);
+    if (std::memcmp(dev_uuid, uuid, VK_UUID_SIZE) == 0)
+      return static_cast<int>(i);
+  }
+  return -1;
+}

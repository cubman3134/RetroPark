+// RetroPark: when enabled, Dolphin's Vulkan backend selects the physical device matching device_uuid,
+// imports the external VkImage (image_handle) + timeline semaphore (timeline_handle) instead of
+// creating its own swapchain, and renders its final frame into that image, signalling the timeline.
+// Set by the in-process host BEFORE Dolphin boots. A process-global (one Dolphin instance per process).
+struct RetroParkExternalPresent
+{
+  bool enabled = false;
+  u8 device_uuid[VK_UUID_SIZE] = {};
+  void* image_handle = nullptr;     // OPAQUE_WIN32 memory handle (host-owned; do not close)
+  void* timeline_handle = nullptr;  // OPAQUE_WIN32 timeline-semaphore handle (host-owned)
+  u32 width = 0;
+  u32 height = 0;
+};

+// RetroPark: dolphin_present.dll — in-process vehicle. Boots Dolphin NORMAL HEADLESS on Vulkan, and a
+// copy-from-XFB producer hooks after_present_event: each present it blits Dolphin's just-rendered XFB
+// image into the host's imported shared VkImage (own command buffer + QFOT release + timeline signal,
+// the refcore_present_vk producer pattern), lock-stepped to the host consume. Not upstream Dolphin.
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <thread>
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <Windows.h>
+
+#include "Common/HookableEvent.h"
+#include "Common/MsgHandler.h"
+#include "Common/WindowSystemInfo.h"
+#include "Common/Config/Config.h"
+
+#include "Core/Boot/Boot.h"
+#include "Core/BootManager.h"
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/Core.h"
+#include "Core/Host.h"
+#include "Core/System.h"
+
+#include "UICommon/UICommon.h"
+
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/Present.h"
+#include "VideoCommon/VideoEvents.h"
+
+#include "VideoBackends/Vulkan/VKTexture.h"
+#include "VideoBackends/Vulkan/VulkanContext.h"
+
+#include <vector>
+
+#include "AudioCommon/Mixer.h"
+#include "AudioCommon/SoundStream.h"
+
+#include "retropark/retropark_abi.h"  // RetroPark C ABI: rp_core_abi / rp_host_iface / rp_surface_set
+
+using Vulkan::g_vulkan_context;
+
+// ---- Host_* callbacks required by DolphinLib (headless no-ops). ----
+std::vector<std::string> Host_GetPreferredLocales() { return {}; }
+void Host_PPCSymbolsChanged() {}
+void Host_PPCBreakpointsChanged() {}
+bool Host_UIBlocksControllerState() { return false; }
+void Host_Message(HostMessageID) {}
+void Host_UpdateTitle(const std::string&) {}
+void Host_UpdateDisasmDialog() {}
+void Host_JitCacheInvalidation() {}
+void Host_JitProfileDataWiped() {}
+void Host_RequestRenderWindowSize(int, int) {}
+bool Host_RendererHasFocus() { return true; }
+bool Host_RendererHasFullFocus() { return true; }
+bool Host_RendererIsFullscreen() { return false; }
+bool Host_TASInputHasFocus() { return false; }
+void Host_YieldToUI() {}
+void Host_TitleChanged() {}
+void Host_UpdateDiscordClientID(const std::string&) {}
+bool Host_UpdateDiscordPresenceRaw(const std::string&, const std::string&, const std::string&,
+                                   const std::string&, const std::string&, const std::string&,
+                                   const int64_t, const int64_t, const int, const int)
+{
+  return false;
+}
+std::unique_ptr<GBAHostInterface> Host_CreateGBAHost(std::weak_ptr<HW::GBA::Core>) { return nullptr; }
+
+namespace
+{
+constexpr uint64_t kOneSecondNs = 1000000000ULL;
+
+// The copy-from-XFB producer. Imports the host's shared VkImage + timeline once (lazily, on the first
+// present when g_vulkan_context is up), then blits the XFB into it each present.
+struct XfbProducer
+{
+  bool tried_init = false;
+  bool ok = false;
+  Common::EventHook hook;
+
+  VkDevice dev = VK_NULL_HANDLE;
+  uint32_t qfam = 0;
+  VkQueue queue = VK_NULL_HANDLE;
+
+  VkImage shared_image = VK_NULL_HANDLE;
+  VkDeviceMemory shared_mem = VK_NULL_HANDLE;
+  VkSemaphore timeline = VK_NULL_HANDLE;
+  VkCommandPool pool = VK_NULL_HANDLE;
+  VkCommandBuffer cmd = VK_NULL_HANDLE;
+  VkFence fence = VK_NULL_HANDLE;
+  PFN_vkWaitSemaphoresKHR pfn_wait = nullptr;
+  uint32_t w = 0, h = 0;
+  uint64_t frame = 0;
+
+  // Set when driven as an rp_core (Slice K): report each frame to the Runtime's SurfaceRing.
+  rp_host_iface rp_host{};
+  uint64_t rp_generation = 0;
+
+  bool Init()
+  {
+    const auto& ext = Vulkan::GetRetroParkExternalPresent();
+    dev = g_vulkan_context->GetDevice();
+    VkPhysicalDevice phys = g_vulkan_context->GetPhysicalDevice();
+    qfam = g_vulkan_context->GetGraphicsQueueFamilyIndex();
+    queue = g_vulkan_context->GetGraphicsQueue();
+    w = ext.width;
+    h = ext.height;
+
+    // Import the shared image (VkImageCreateInfo byte-matches the host's exported image).
+    VkExternalMemoryImageCreateInfo emici = {};
+    emici.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+    emici.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+    VkImageCreateInfo ici = {};
+    ici.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    ici.pNext = &emici;
+    ici.imageType = VK_IMAGE_TYPE_2D;
+    ici.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ici.extent = {w, h, 1};
+    ici.mipLevels = 1;
+    ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT;
+    ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    ici.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vkCreateImage(dev, &ici, nullptr, &shared_image) != VK_SUCCESS)
+      return false;
+
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(dev, shared_image, &req);
+    VkPhysicalDeviceMemoryProperties mp;
+    vkGetPhysicalDeviceMemoryProperties(phys, &mp);
+    uint32_t mem_type = UINT32_MAX;
+    for (uint32_t i = 0; i < mp.memoryTypeCount; i++)
+      if ((req.memoryTypeBits & (1u << i)) &&
+          (mp.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+      {
+        mem_type = i;
+        break;
+      }
+    if (mem_type == UINT32_MAX)
+      return false;
+
+    VkImportMemoryWin32HandleInfoKHR imp = {};
+    imp.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_WIN32_HANDLE_INFO_KHR;
+    imp.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+    imp.handle = ext.image_handle;
+    VkMemoryDedicatedAllocateInfo ded = {};
+    ded.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+    ded.image = shared_image;
+    ded.pNext = &imp;
+    VkMemoryAllocateInfo mai = {};
+    mai.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+    mai.pNext = &ded;
+    mai.allocationSize = req.size;
+    mai.memoryTypeIndex = mem_type;
+    if (vkAllocateMemory(dev, &mai, nullptr, &shared_mem) != VK_SUCCESS)
+      return false;
+    if (vkBindImageMemory(dev, shared_image, shared_mem, 0) != VK_SUCCESS)
+      return false;
+
+    // Import the timeline semaphore.
+    VkSemaphoreTypeCreateInfo tci = {};
+    tci.sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO;
+    tci.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
+    VkSemaphoreCreateInfo sci = {};
+    sci.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+    sci.pNext = &tci;
+    if (vkCreateSemaphore(dev, &sci, nullptr, &timeline) != VK_SUCCESS)
+      return false;
+    auto pfn_import = reinterpret_cast<PFN_vkImportSemaphoreWin32HandleKHR>(
+        vkGetDeviceProcAddr(dev, "vkImportSemaphoreWin32HandleKHR"));
+    pfn_wait = reinterpret_cast<PFN_vkWaitSemaphoresKHR>(vkGetDeviceProcAddr(dev, "vkWaitSemaphoresKHR"));
+    if (!pfn_import || !pfn_wait)
+      return false;
+    VkImportSemaphoreWin32HandleInfoKHR isi = {};
+    isi.sType = VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_WIN32_HANDLE_INFO_KHR;
+    isi.semaphore = timeline;
+    isi.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+    isi.handle = ext.timeline_handle;
+    if (pfn_import(dev, &isi) != VK_SUCCESS)
+      return false;
+
+    // Own command pool + buffer + fence.
+    VkCommandPoolCreateInfo pci = {};
+    pci.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = qfam;
+    if (vkCreateCommandPool(dev, &pci, nullptr, &pool) != VK_SUCCESS)
+      return false;
+    VkCommandBufferAllocateInfo cbai = {};
+    cbai.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+    cbai.commandPool = pool;
+    cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cbai.commandBufferCount = 1;
+    if (vkAllocateCommandBuffers(dev, &cbai, &cmd) != VK_SUCCESS)
+      return false;
+    VkFenceCreateInfo fci = {};
+    fci.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    if (vkCreateFence(dev, &fci, nullptr, &fence) != VK_SUCCESS)
+      return false;
+    return true;
+  }
+
+  void OnPresent()
+  {
+    if (!tried_init)
+    {
+      tried_init = true;
+      ok = Init();
+    }
+    if (!ok)
+      return;
+
+    const AbstractTexture* xfb = g_presenter ? g_presenter->GetCurrentXFBTexture() : nullptr;
+    if (!xfb)
+      return;
+    const auto* vxfb = static_cast<const Vulkan::VKTexture*>(xfb);
+    VkImage src = vxfb->GetImage();
+    VkImageLayout src_layout = vxfb->GetLayout();
+    const uint32_t sw = vxfb->GetWidth(), sh = vxfb->GetHeight();
+
+    // Lock-step: before overwriting the shared image, wait for the host to have consumed the previous
+    // frame (timeline >= 2f+1). Frame 0 does not wait.
+    if (frame > 0)
+    {
+      uint64_t wait_val = 2 * frame + 1;
+      VkSemaphoreWaitInfo swi = {};
+      swi.sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO;
+      swi.semaphoreCount = 1;
+      swi.pSemaphores = &timeline;
+      swi.pValues = &wait_val;
+      pfn_wait(dev, &swi, kOneSecondNs);
+    }
+
+    vkResetCommandBuffer(cmd, 0);
+    VkCommandBufferBeginInfo bi = {};
+    bi.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(cmd, &bi);
+
+    auto barrier = [&](VkImage img, VkImageLayout ol, VkImageLayout nl, uint32_t sq, uint32_t dq,
+                       VkAccessFlags sa, VkAccessFlags da) {
+      VkImageMemoryBarrier b = {};
+      b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+      b.srcAccessMask = sa;
+      b.dstAccessMask = da;
+      b.oldLayout = ol;
+      b.newLayout = nl;
+      b.srcQueueFamilyIndex = sq;
+      b.dstQueueFamilyIndex = dq;
+      b.image = img;
+      b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           0, 0, nullptr, 0, nullptr, 1, &b);
+    };
+
+    // XFB (Dolphin's) -> TRANSFER_SRC; shared (ours) UNDEFINED -> GENERAL (discard prior contents).
+    barrier(src, src_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, qfam, qfam,
+            VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    barrier(shared_image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL, qfam, qfam, 0,
+            VK_ACCESS_TRANSFER_WRITE_BIT);
+
+    VkImageBlit region = {};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.srcOffsets[0] = {0, 0, 0};
+    region.srcOffsets[1] = {(int32_t)sw, (int32_t)sh, 1};
+    region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstOffsets[0] = {0, 0, 0};
+    region.dstOffsets[1] = {(int32_t)w, (int32_t)h, 1};
+    vkCmdBlitImage(cmd, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, shared_image,
+                   VK_IMAGE_LAYOUT_GENERAL, 1, &region, VK_FILTER_LINEAR);
+
+    // Restore XFB to its original layout (so Dolphin's tracking stays correct); release the shared
+    // image to the external queue family (GENERAL->GENERAL QFOT, Slice B cross-device pattern).
+    barrier(src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, src_layout, qfam, qfam,
+            VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_MEMORY_READ_BIT);
+    barrier(shared_image, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL, qfam,
+            VK_QUEUE_FAMILY_EXTERNAL_KHR, VK_ACCESS_TRANSFER_WRITE_BIT, 0);
+    vkEndCommandBuffer(cmd);
+
+    const uint64_t signal_val = 2 * frame + 2;
+    VkTimelineSemaphoreSubmitInfo tssi = {};
+    tssi.sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO;
+    tssi.signalSemaphoreValueCount = 1;
+    tssi.pSignalSemaphoreValues = &signal_val;
+    VkSubmitInfo si = {};
+    si.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+    si.pNext = &tssi;
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd;
+    si.signalSemaphoreCount = 1;
+    si.pSignalSemaphores = &timeline;
+
+    vkResetFences(dev, 1, &fence);
+    if (vkQueueSubmit(queue, 1, &si, fence) == VK_SUCCESS)
+    {
+      vkWaitForFences(dev, 1, &fence, VK_TRUE, kOneSecondNs);
+      Vulkan::GetRetroParkLastSignaledValue().store(signal_val, std::memory_order_release);
+      if (rp_host.submit_frame)
+        rp_host.submit_frame(rp_host.host, 0, rp_generation, signal_val);
+      ++frame;
+    }
+  }
+};
+
+XfbProducer g_producer;
+std::thread g_host_thread;
+std::atomic<bool> g_running{false};
+
+void HostThread(std::string rom, std::string user_dir)
+{
+  // No modal dialogs: a no-op alert handler (returns "proceed") intercepts every panic regardless of
+  // timing, so nothing blocks the run.
+  Common::SetEnableAlert(false);
+  Common::RegisterMsgAlertHandler(
+      [](const char*, const char*, bool, Common::MsgType) -> bool { return true; });
+  UICommon::SetUserDirectory(user_dir);
+  UICommon::Init();
+  Config::SetBaseOrCurrent(Config::MAIN_GFX_BACKEND, "Vulkan");
+  Config::SetBaseOrCurrent(Config::MAIN_USE_PANIC_HANDLERS, false);
+  // Single-threaded submission so our own vkQueueSubmit (in the present hook) never races Dolphin's
+  // submit worker on the same graphics queue.
+  Config::SetBaseOrCurrent(Config::GFX_BACKEND_MULTITHREADING, false);
+
+  // Host-owned audio (Slice L): Dolphin opens NO device — the DSP still feeds the SoundStream's Mixer,
+  // and our puller thread (below) pulls that mix and forwards it to the host via rp_host.audio_sample.
+  Config::SetBaseOrCurrent(Config::MAIN_AUDIO_BACKEND, BACKEND_NULLSOUND);
+
+  // Fast-boot the vehicle to the audio-producing part of the game: the lock-step present throttles
+  // emulation to the host's consume rate, so only a few game-seconds elapse in the gated capture window.
+  // Skip the GC IPL and speed up the disc transfer so the apploader/load (a silent white screen that
+  // otherwise eats the whole window) completes in far fewer game-frames and the game reaches its
+  // logo/title audio before the capture ends.
+  Config::SetBaseOrCurrent(Config::MAIN_SKIP_IPL, true);
+  Config::SetBaseOrCurrent(Config::MAIN_FAST_DISC_SPEED, true);
+
+  // Create a HIDDEN Win32 window so Dolphin's present path runs (fires after_present_event + populates
+  // the current XFB) — pure headless skips presentation entirely, so the XFB is never available there.
+  // The window is never shown; Dolphin's own swapchain presents to it invisibly, and our producer
+  // copies the XFB into the host's shared image.
+  const auto& ext0 = Vulkan::GetRetroParkExternalPresent();
+  static const wchar_t* kClass = L"RetroParkDolphinHidden";
+  WNDCLASSEXW wc = {};
+  wc.cbSize = sizeof(wc);
+  wc.lpfnWndProc = DefWindowProcW;
+  wc.hInstance = GetModuleHandleW(nullptr);
+  wc.lpszClassName = kClass;
+  RegisterClassExW(&wc);
+  // WS_POPUP (no chrome), positioned off-screen and never shown — only a surface for Dolphin's
+  // swapchain so its present path runs; the game is never visible in it.
+  HWND hwnd = CreateWindowExW(WS_EX_TOOLWINDOW, kClass, L"", WS_POPUP, -32000, -32000, (int)ext0.width,
+                              (int)ext0.height, nullptr, nullptr, wc.hInstance, nullptr);
+  ShowWindow(hwnd, SW_HIDE);
+  const WindowSystemInfo wsi(WindowSystemType::Windows, nullptr, hwnd, hwnd);
+  UICommon::InitControllers(wsi);
+
+  // Blit the XFB into the host's shared image on every present.
+  g_producer.hook =
+      GetVideoEvents().after_present_event.Register([](const PresentInfo&) { g_producer.OnPresent(); });
+
+  auto& system = Core::System::GetInstance();
+  auto boot = BootParameters::GenerateFromFile(
+      rom, BootSessionData(std::nullopt, DeleteSavestateAfterBoot::No));
+  if (boot && BootManager::BootCore(system, std::move(boot), wsi))
+  {
+    // Audio puller (Slice L): NullSound::Init() zeroes the mixer output rate, so latch it back to
+    // 48 kHz on the first valid SoundStream, then pull ~10 ms chunks of interleaved stereo s16 and
+    // forward them to the host. Runs only in rp_core mode (rp_host.audio_sample set by dp_set_surfaces);
+    // the Slice-J direct C-API path leaves it null, so audio stays silent there — unchanged. Pacing is
+    // naive wall-clock (A/V sync is a deferred slice); XAudio2's queue absorbs the jitter.
+    std::thread audio_thread([&system]() {
+      constexpr std::size_t kFrames = 480;  // ~10 ms @ 48 kHz
+      std::vector<int16_t> buf(kFrames * 2, 0);
+      bool rate_set = false;
+      while (g_running.load(std::memory_order_acquire))
+      {
+        SoundStream* ss = system.GetSoundStream();
+        if (ss && g_producer.rp_host.audio_sample)
+        {
+          if (!rate_set) { ss->GetMixer()->SetSampleRate(48000); rate_set = true; }
+          std::size_t got = ss->GetMixer()->Mix(buf.data(), kFrames);
+          if (got > 0)
+            g_producer.rp_host.audio_sample(g_producer.rp_host.host, buf.data(), got);
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+      }
+    });
+
+    while (g_running.load(std::memory_order_acquire))
+    {
+      MSG msg;
+      while (PeekMessageW(&msg, nullptr, 0, 0, PM_REMOVE))
+      {
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+      }
+      Core::HostDispatchJobs(system);
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    // Stop pulling BEFORE Core::Shutdown destroys the SoundStream/Mixer.
+    if (audio_thread.joinable())
+      audio_thread.join();
+    Core::Stop(system);
+    Core::Shutdown(system);
+  }
+
+  g_producer.hook.reset();
+  if (hwnd)
+    DestroyWindow(hwnd);
+  UICommon::ShutdownControllers();
+  UICommon::Shutdown();
+}
+
+// Spawn the Dolphin host thread for `rom` (surfaces come from RetroParkExternalPresent, set by the
+// caller). Returns false if already running.
+bool BootDolphinThread(std::string rom)
+{
+  if (g_running.load())
+    return false;
+  g_running.store(true, std::memory_order_release);
+  g_host_thread = std::thread(HostThread, std::move(rom), std::string());
+  return true;
+}
+
+void StopDolphinThread()
+{
+  g_running.store(false, std::memory_order_release);
+  if (g_host_thread.joinable())
+    g_host_thread.join();
+}
+}  // namespace
+
+// ---- Slice J direct-handoff C API (used by the standalone test). ----
+extern "C"
+{
+  __declspec(dllexport) int rp_dolphin_boot(const uint8_t* device_uuid, void* image_handle,
+                                            void* timeline_handle, uint32_t width, uint32_t height,
+                                            const char* rom_path, const char* user_dir)
+  {
+    (void)user_dir;
+    auto& ext = Vulkan::GetRetroParkExternalPresent();
+    ext.enabled = true;
+    std::memcpy(ext.device_uuid, device_uuid, 16);
+    ext.image_handle = image_handle;
+    ext.timeline_handle = timeline_handle;
+    ext.width = width;
+    ext.height = height;
+    g_producer.rp_host = rp_host_iface{};  // C-API mode: report via the global, not submit_frame
+    return BootDolphinThread(std::string(rom_path ? rom_path : "")) ? 0 : 1;
+  }
+
+  __declspec(dllexport) uint64_t rp_dolphin_last_signal()
+  {
+    return Vulkan::GetRetroParkLastSignaledValue().load(std::memory_order_acquire);
+  }
+
+  __declspec(dllexport) void rp_dolphin_stop() { StopDolphinThread(); }
+}
+
+// ---- Slice K: dolphin_present as a loadable RetroPark presenting core (rp_core_abi). ----
+namespace
+{
+struct DolphinCore
+{
+  rp_host_iface host{};
+  std::string rom;
+};
+
+void dp_get_info(rp_core_info* out)
+{
+  out->abi_version = RETROPARK_ABI_VERSION;
+  out->type = RP_CORE_PRESENTING;
+  out->graphics_api = RP_GFX_VULKAN;
+  out->id = "dolphin_present";
+}
+rp_core* dp_create(const rp_host_iface* host)
+{
+  auto* c = new DolphinCore();
+  c->host = *host;
+  return reinterpret_cast<rp_core*>(c);
+}
+void dp_destroy(rp_core* core)
+{
+  StopDolphinThread();
+  delete reinterpret_cast<DolphinCore*>(core);
+}
+rp_result dp_load_content(rp_core* core, const char* path)
+{
+  reinterpret_cast<DolphinCore*>(core)->rom = path ? path : "";
+  return RP_OK;
+}
+rp_result dp_set_surfaces(rp_core* core, const rp_surface_set* set)
+{
+  if (!set || set->count < 1)
+    return RP_ERR_BAD_ARG;
+  auto* c = reinterpret_cast<DolphinCore*>(core);
+  auto& ext = Vulkan::GetRetroParkExternalPresent();
+  ext.enabled = true;
+  std::memcpy(ext.device_uuid, set->device_uuid, 16);
+  ext.image_handle = set->surfaces[0].shared_handle;
+  ext.timeline_handle = set->sync_handle;
+  ext.width = set->surfaces[0].width;
+  ext.height = set->surfaces[0].height;
+  g_producer.rp_host = c->host;  // rp_core mode: report each frame via submit_frame
+  g_producer.rp_generation = set->surfaces[0].generation;
+  return RP_OK;
+}
+rp_result dp_start(rp_core* core)
+{
+  auto* c = reinterpret_cast<DolphinCore*>(core);
+  if (c->rom.empty())
+    return RP_ERR_INTERNAL;
+  return BootDolphinThread(c->rom) ? RP_OK : RP_ERR_DEVICE;
+}
+rp_result dp_stop(rp_core*)
+{
+  StopDolphinThread();
+  return RP_OK;
+}
+void dp_get_av_info(rp_core*, rp_av_info* out)
+{
+  // Dolphin's SoundStream mixer runs at a fixed 48 kHz (we force it there after the Null backend zeroes
+  // it); the producer pulls that mix and forwards interleaved stereo s16, so the host opens XAudio2 at
+  // this rate. Geometry is unused (presenting core, not driven-validated). Constant to avoid racing the
+  // async boot — the Runtime queries this right after start(), before the SoundStream may exist.
+  out->fps = 0.0;
+  out->sample_rate = 48000.0;
+  out->base_width = 0; out->base_height = 0; out->max_width = 0; out->max_height = 0;
+  out->pixel_format = 0;
+}
+
+const rp_core_abi kAbi = {
+    RETROPARK_ABI_VERSION, dp_get_info,    dp_create,      dp_destroy, dp_set_surfaces,
+    dp_start,              dp_stop,        dp_get_av_info, nullptr,    nullptr,
+    nullptr,               nullptr,        dp_load_content};
+}  // namespace
+
+extern "C" __declspec(dllexport) const rp_core_abi* rp_get_core_abi(void) { return &kAbi; }

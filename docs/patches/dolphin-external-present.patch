+bool Host_UpdateDiscordPresenceRaw(const std::string&, const std::string&, const std::string&,
+                                   const std::string&, const std::string&, const std::string&,
+                                   const int64_t, const int64_t, const int, const int)
+{
+  return false;
+}
+std::unique_ptr<GBAHostInterface> Host_CreateGBAHost(std::weak_ptr<HW::GBA::Core>) { return nullptr; }
+
+namespace
+{
+// rp_core / direct-C-API handoff state. With the direct multi-slot present redesign, Dolphin's Vulkan
+// backend renders straight into the host's N shared images and signals the timeline in its OWN submit
+// (VKGfx::PresentBackbuffer), reporting each frame to the host ring via GetRetroParkCoreHost().submit_frame.
+// The old copy-from-XFB producer (a second queue submit + blit that topped out ~87%) is gone. All this TU
+// still needs is the host iface for the audio puller + input override, and the ring generation.
+struct RpCoreRuntime
+{
+  rp_host_iface rp_host{};
+  uint64_t rp_generation = 0;
+};
+RpCoreRuntime g_rt_host;
+
+// Free-running presented-frame counter (after_present_event), never reset by netplay. Exposed via
+// rp_dolphin_present_count() as an honest emulation-speed clock: frames/wall-second / ~59.94 = real-time %.
+std::atomic<uint64_t> g_present_total{0};
+Common::EventHook g_np_frame_hook;   // always-on presented-frame counter (netplay frame-progress proof)
+std::thread g_host_thread;
+std::atomic<bool> g_running{false};
+
+Common::UniqueBuffer<u8> g_state_buf;   // last captured savestate
+size_t g_state_size = 0;                // its actual byte length (buffer may be larger)
+
+// ---- Slice O netplay boot seam (shared with the netplay section further down in this TU). ----
+// Netplay boots on a thread that owns the hidden window/WSI — the same HostThread that a normal boot
+// uses. But under netplay the game to boot (and the net-synced BootSessionData) is handed to us by the
+// NetPlayClient's StartGame flow, not chosen up front. So a netplay-armed HostThread does all the usual
+// window/config/hook setup and then WAITS for BootGame to post a RpBootRequest, mirroring how the Qt
+// dialog's m_start_game_callback bridges NetPlayUI::BootGame to the boot. These live above HostThread so
+// it can reference them; they are visible to the netplay UI/exports below (same translation unit).
+std::atomic<int> g_np_started{0};        // set to 1 only AFTER a netplay BootCore succeeds (honest signal)
+std::atomic<uint32_t> g_np_frame{0};     // presented-frame counter — proves frames actually ADVANCE, not
+                                         // just that boot was initiated (a frozen game reports 0 forever)
+std::atomic<bool> g_netplay_armed{false};
+std::atomic<bool> g_np_host_ready{false};// HostThread finished UICommon::Init + window setup
+std::string g_netplay_rom;               // the ROM both peers were armed with (identical path on both)
+struct RpBootRequest
+{
+  std::string filename;
+  std::unique_ptr<BootSessionData> bsd;
+};
+std::mutex g_boot_mutex;
+std::condition_variable g_boot_cv;
+std::optional<RpBootRequest> g_boot_request;   // posted by BootGame, consumed by the netplay HostThread
+
+// Directory of the module that contains this function (the dolphin_present DLL), NOT the host exe.
+std::filesystem::path ThisModuleDir()
+{
+  HMODULE mod = nullptr;
+  if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                             GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         reinterpret_cast<LPCWSTR>(&ThisModuleDir), &mod))
+  {
+    wchar_t buf[MAX_PATH]{};
+    if (GetModuleFileNameW(mod, buf, MAX_PATH))
+      return std::filesystem::path(buf).parent_path();
+  }
+  return {};
+}
+
+// Ensure Dolphin can find its Sys directory (GameCube IPL fonts, GameINIs, shaders). On Windows Dolphin
+// derives Sys from the HOST process's exe directory, but dolphin_present is embedded as a DLL — a Sys-less
+// host (e.g. a test/harness exe) leaves GetSysDirectory() pointing at a nonexistent path, so the GC system
+// font never loads and any game text drawn with it renders BLANK (Sonic Mega Collection's manual/title
+// panel was the visible symptom). Probe locations relative to THIS DLL (and the host exe) for a real Sys
+// and hand it to Dolphin via the RP_DOLPHIN_SYS_DIR override. A pre-set env (deliberate escape hatch /
+// test control) always wins.
+void EnsureDolphinSysDir()
+{
+  if (const char* pre = std::getenv("RP_DOLPHIN_SYS_DIR"); pre && *pre)
+    return;  // caller pinned it explicitly
+
+  namespace fs = std::filesystem;
+  const fs::path dll = ThisModuleDir();
+  wchar_t exe[MAX_PATH]{};
+  const fs::path exe_dir =
+      GetModuleFileNameW(nullptr, exe, MAX_PATH) ? fs::path(exe).parent_path() : fs::path{};
+
+  // First existing candidate that actually holds the GC font wins. Order: the DLL's own dir (a Sys shipped
+  // beside the core), the deployed app root (cores/dolphin_present -> ..\..\Sys), the dev source tree
+  // (Binary/x64 -> ..\..\Data\Sys), and finally the host exe's Sys (stock Dolphin location).
+  std::vector<fs::path> cands;
+  if (!dll.empty())
+  {
+    cands.push_back(dll / "Sys");
+    cands.push_back(dll / ".." / ".." / "Sys");
+    cands.push_back(dll / ".." / ".." / "Data" / "Sys");
+  }
+  if (!exe_dir.empty())
+    cands.push_back(exe_dir / "Sys");
+
+  std::error_code ec;
+  for (const auto& c : cands)
+  {
+    if (fs::exists(c / "GC" / "font_western.bin", ec))
+    {
+      const std::string val = fs::weakly_canonical(c, ec).string();
+      _putenv_s("RP_DOLPHIN_SYS_DIR", (ec ? c.string() : val).c_str());
+      return;
+    }
+  }
+  // No Sys found anywhere — leave Dolphin's default resolution in place (nothing we can do here).
+}
+
+// ---- Core options (Task A1): internal-resolution + aspect-ratio exposed via rp_core_abi. ----
+// Effective option values (string), keyed by option id. Empty/absent => Dolphin default. Applied to
+// Dolphin's Config both at boot (the config block in HostThread reads this) and live (dp_core_option_set).
+static std::unordered_map<std::string, std::string> g_dp_options;
+static std::mutex g_dp_options_mtex;
+static void ApplyDolphinOptionToConfig(const std::string& key, const std::string& val)
+{
+  if (key == "dolphin_internal_resolution")
+  {
+    int scale = std::max(1, atoi(val.c_str()));
+    Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, scale);
+  }
+  else if (key == "dolphin_aspect_ratio")
+  {
+    // AspectMode ordinal in THIS tree (VideoConfig.h): Auto=0, ForceWide(16:9)=1, ForceStandard(4:3)=2,
+    // Stretch=3 — matches the descriptor below, so the direct ordinal cast is correct here.
+    Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, static_cast<AspectMode>(atoi(val.c_str())));
+  }
+}
+
+void HostThread(std::string rom, std::string user_dir, bool netplay)
+{
+  // Point Dolphin at a real Sys dir BEFORE anything reads GetSysDirectory() (UICommon::Init, config load,
+  // boot). Must run first — GetSysDirectory() caches its result on first use.
+  EnsureDolphinSysDir();
+  // No modal dialogs: a no-op alert handler (returns "proceed") intercepts every panic regardless of
+  // timing, so nothing blocks the run.
+  Common::SetEnableAlert(false);
+  Common::RegisterMsgAlertHandler(
+      [](const char*, const char*, bool, Common::MsgType) -> bool { return true; });
+  if (const char* ud = std::getenv("RP_DOLPHIN_USERDIR"); ud && *ud)
+    user_dir = ud;   // diagnostic override so framedumps land in a known dir
+  UICommon::SetUserDirectory(user_dir);
+  UICommon::Init();
+  Config::SetBaseOrCurrent(Config::MAIN_GFX_BACKEND, "Vulkan");
+  Config::SetBaseOrCurrent(Config::MAIN_USE_PANIC_HANDLERS, false);
+  // Direct multi-slot present: Dolphin's own video worker is now the ONLY graphics-queue submitter
+  // (the copy-from-XFB producer, and its second submit, are gone), so threaded video is safe and lets
+  // the video thread pipeline against emulation the way standalone Dolphin does. This is a key part of
+  // reaching ~100% real-time. (Under the old copy path this had to stay false to avoid a queue race.)
+  Config::SetBaseOrCurrent(Config::GFX_BACKEND_MULTITHREADING, true);
+
+  // Render accuracy: EFB/XFB copies to RAM + EFB CPU access, matching the accurate graphics settings a
+  // normal Dolphin install uses. (This is NOT what makes Sonic Mega Collection's 2D title/manual TEXT
+  // draw — that panel is rendered with the GameCube system font and was blank purely because the embedded
+  // vehicle could not find Dolphin's Sys dir; see the Sys resolution at the top of HostThread. These
+  // copy settings are kept for general EFB-readback accuracy.) Cost is negligible at the 640x480 present
+  // size. RP_DOLPHIN_FAST_COPIES reverts to the fast defaults for A/B or an EFB-readback-heavy game.
+  if (!std::getenv("RP_DOLPHIN_FAST_COPIES"))
+  {
+    Config::SetBaseOrCurrent(Config::GFX_HACK_SKIP_EFB_COPY_TO_RAM, false);        // EFBToTextureEnable=False
+    Config::SetBaseOrCurrent(Config::GFX_HACK_SKIP_XFB_COPY_TO_RAM, false);        // XFBToTextureEnable=False
+    Config::SetBaseOrCurrent(Config::GFX_HACK_EFB_ACCESS_ENABLE, true);            // EFBAccessEnable=True
+    Config::SetBaseOrCurrent(Config::GFX_HACK_EFB_EMULATE_FORMAT_CHANGES, true);   // EFBEmulateFormatChanges=True
+    Config::SetBaseOrCurrent(Config::GFX_SAFE_TEXTURE_CACHE_COLOR_SAMPLES, 0);     // SafeTextureCacheColorSamples=0
+  }
+
+  // DIAGNOSTIC: dump Dolphin's OWN internal frames (XFB->PNG, independent of RetroPark's shared-image
+  // present path). Lets a capture test compare "what Dolphin rendered" vs "what our present delivered" to
+  // isolate a present-path drop from a genuine Dolphin render. Frames land in <userdir>/Dump/Frames.
+  if (std::getenv("RP_DOLPHIN_FRAMEDUMP"))
+  {
+    Config::SetBaseOrCurrent(Config::MAIN_MOVIE_DUMP_FRAMES, true);
+    Config::SetBaseOrCurrent(Config::MAIN_MOVIE_DUMP_FRAMES_SILENT, true);
+    Config::SetBaseOrCurrent(Config::GFX_DUMP_FRAMES_AS_IMAGES, true);
+  }
+
+  // Host-owned audio (Slice L): Dolphin opens NO device — the DSP still feeds the SoundStream's Mixer,
+  // and our puller thread (below) pulls that mix and forwards it to the host via rp_host.audio_sample.
+  Config::SetBaseOrCurrent(Config::MAIN_AUDIO_BACKEND, BACKEND_NULLSOUND);
+
+  // Host-owned input (Slice M): port 0 is a standard GC controller so the SI polls it; our override
+  // (installed after boot) feeds it from rp_host.input_state. Without this, nothing polls input.
+  Config::SetBaseOrCurrent(Config::GetInfoForSIDevice(0), SerialInterface::SIDEVICE_GC_CONTROLLER);
+
+  // Fast-boot the vehicle to the audio-producing part of the game: the lock-step present throttles
+  // emulation to the host's consume rate, so only a few game-seconds elapse in the gated capture window.
+  // Skip the GC IPL and speed up the disc transfer so the apploader/load (a silent white screen that
+  // otherwise eats the whole window) completes in far fewer game-frames and the game reaches its
+  // logo/title audio before the capture ends.
+  Config::SetBaseOrCurrent(Config::MAIN_SKIP_IPL, true);
+  Config::SetBaseOrCurrent(Config::MAIN_FAST_DISC_SPEED, true);
+
+  // Apply any core-option overrides recorded before boot (dp_core_option_set while not running stashes
+  // into g_dp_options; this is where they take effect). Placed after the fixed settings so a user option
+  // wins. A live set (game already running) applies itself on the CPU thread instead — see dp_core_option_set.
+  {
+    std::lock_guard<std::mutex> lk(g_dp_options_mtex);
+    for (auto& [k, v] : g_dp_options)
+      ApplyDolphinOptionToConfig(k, v);
+  }
+
+  if (netplay)
+  {
+    // Headless netplay has no game list / memory-card sync UI, so disable the save + cheat-code sync
+    // handshakes: with these off, the host's RequestStartGame starts the game immediately instead of
+    // deferring on a data-sync round-trip. Determinism is unaffected — both peers boot from the same
+    // net-synced NetSettings, and both run this identical config, so timebases stay in lockstep.
+    Config::SetBaseOrCurrent(Config::NETPLAY_SAVEDATA_LOAD, false);
+    Config::SetBaseOrCurrent(Config::NETPLAY_SYNC_CODES, false);
+  }
+
+  // Create a HIDDEN Win32 window so Dolphin's present path runs (fires after_present_event + populates
+  // the current XFB) — pure headless skips presentation entirely, so the XFB is never available there.
+  // The window is never shown; Dolphin's own swapchain presents to it invisibly, and our producer
+  // copies the XFB into the host's shared image.
+  const auto& ext0 = Vulkan::GetRetroParkExternalPresent();
+  // Netplay boots with no host surfaces (ext disabled) — Dolphin then presents normally into this
+  // hidden window instead of into a shared image. Fall back to a sane window size so the swapchain has
+  // valid dimensions; the game is never visible, we only need its present path to run frames.
+  const int win_w = ext0.width ? (int)ext0.width : 640;
+  const int win_h = ext0.height ? (int)ext0.height : 480;
+  static const wchar_t* kClass = L"RetroParkDolphinHidden";
+  WNDCLASSEXW wc = {};
+  wc.cbSize = sizeof(wc);
+  wc.lpfnWndProc = DefWindowProcW;
+  wc.hInstance = GetModuleHandleW(nullptr);
+  wc.lpszClassName = kClass;
+  RegisterClassExW(&wc);
+  // WS_POPUP (no chrome), positioned off-screen and never shown — only a surface for Dolphin's
+  // swapchain so its present path runs; the game is never visible in it.
+  HWND hwnd = CreateWindowExW(WS_EX_TOOLWINDOW, kClass, L"", WS_POPUP, -32000, -32000, win_w, win_h,
+                              nullptr, nullptr, wc.hInstance, nullptr);
+  ShowWindow(hwnd, SW_HIDE);
+  const WindowSystemInfo wsi(WindowSystemType::Windows, nullptr, hwnd, hwnd);
+  UICommon::InitControllers(wsi);
+
+  // Presented-frame counter. With direct present there is no XFB-blit hook; a single always-on hook
+  // ticks once per presented frame in BOTH the rp_core/external and netplay/hidden-window modes.
+  // g_np_frame is the netplay frame-progress proof (reset per boot; a game frozen on a broken input
+  // exchange presents nothing, turning a vacuous desynced==0 into a real failure). g_present_total is a
+  // free-running speed clock read by rp_dolphin_present_count().
+  g_np_frame.store(0, std::memory_order_relaxed);
+  g_present_total.store(0, std::memory_order_relaxed);
+  g_np_frame_hook = GetVideoEvents().after_present_event.Register([](const PresentInfo&) {
+    g_np_frame.fetch_add(1, std::memory_order_relaxed);
+    g_present_total.fetch_add(1, std::memory_order_relaxed);
+  });
+
+  auto& system = Core::System::GetInstance();
+
+  std::unique_ptr<BootParameters> boot;
+  if (netplay)
+  {
+    // Window/config/hook are up; let the arming side (and GameFile/SetupNetSettings) proceed, then wait
+    // for Dolphin's netplay StartGame flow to hand us the ROM + net-synced BootSessionData via BootGame.
+    g_np_host_ready.store(true, std::memory_order_release);
+    std::unique_lock<std::mutex> lk(g_boot_mutex);
+    g_boot_cv.wait(lk, [] {
+      return g_boot_request.has_value() || !g_running.load(std::memory_order_acquire);
+    });
+    if (g_boot_request.has_value())
+    {
+      RpBootRequest req = std::move(*g_boot_request);
+      g_boot_request.reset();
+      lk.unlock();
+      boot = BootParameters::GenerateFromFile(req.filename, std::move(*req.bsd));
+    }
+    // else: stopped before a game was armed — fall through to teardown with a null boot.
+  }
+  else
+  {
+    boot = BootParameters::GenerateFromFile(
+        rom, BootSessionData(std::nullopt, DeleteSavestateAfterBoot::No));
+  }
+
+  if (boot && BootManager::BootCore(system, std::move(boot), wsi))
+  {
+    if (netplay)
+      g_np_started.store(1);   // the netplay game actually booted and is now running (honest signal)
+    // Audio puller (Slice L + adaptive feeder): NullSound::Init() zeroes the mixer output rate, so latch
+    // it back to 48 kHz on the first valid SoundStream, then feed the host ADAPTIVELY. Each poll, ask the
+    // host how many frames its output queue can accept right now (rp_host.audio_want) and pull EXACTLY
+    // that many from Dolphin's mixer. The pull rate thereby self-locks to the host's real 48 kHz playback
+    // clock -- when a poll runs late, audio_want returns a proportionally larger deficit and we catch up.
+    // This replaces the old fixed 480-frames-per-10ms push, whose supply rate was set by the OS timer
+    // (not the playback clock); the two clocks drifted and the XAudio2 queue periodically starved ->
+    // underrun pops (crackle), worst when the emulator ran below full speed. Dolphin's mixer rate-matches
+    // whatever it is asked for, exactly as standalone Dolphin's own audio backend pulls it. Runs only in
+    // rp_core mode (audio_sample set by dp_set_surfaces); the Slice-J direct C-API path leaves it null.
+    std::thread audio_thread([&system]() {
+      constexpr std::size_t kMaxFrames = 4800;  // 100 ms cap on one pull, bounding a post-stall catch-up
+      std::vector<int16_t> buf(kMaxFrames * 2, 0);
+      bool rate_set = false;
+      while (g_running.load(std::memory_order_acquire))
+      {
+        SoundStream* ss = system.GetSoundStream();
+        if (ss && g_rt_host.rp_host.audio_sample)
+        {
+          if (!rate_set) { ss->GetMixer()->SetSampleRate(48000); rate_set = true; }
+          // Fixed fallback only if an older host lacks audio_want; the ABI is version-gated (v7), so in
+          // rp_core mode audio_want is always present -- this guards the direct-C-API/None paths.
+          std::size_t want = g_rt_host.rp_host.audio_want
+              ? g_rt_host.rp_host.audio_want(g_rt_host.rp_host.host)
+              : 480;
+          if (want > kMaxFrames) want = kMaxFrames;
+          // Submit the deficit as SEVERAL small buffers, not one big one. Each audio_sample buffer plays as
+          // an indivisible unit on the voice, so a single 40 ms buffer leaves the queue one-deep -- when it
+          // drains there is a gap before the next poll refills (a pop every buffer). Chunking to ~10 ms keeps
+          // multiple buffers in flight, so the oldest always finishes with newer ones still queued (overlap).
+          constexpr std::size_t kChunk = 512;  // ~10.7 ms @ 48 kHz per voice buffer
+          while (want > 0)
+          {
+            std::size_t n = want < kChunk ? want : kChunk;
+            std::size_t got = ss->GetMixer()->Mix(buf.data(), n);
+            if (got > 0)
+              g_rt_host.rp_host.audio_sample(g_rt_host.rp_host.host, buf.data(), got);
+            if (got < n) break;   // mixer returned short (should not happen) -> avoid a spin
+            want -= n;
+          }
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+      }
+    });
+
+    bool input_override_installed = false;
+    while (g_running.load(std::memory_order_acquire))
+    {
+      if (!input_override_installed && Pad::IsInitialized() && Pad::GetConfig() &&
+          Pad::GetConfig()->GetControllerCount() > 0)
+      {
+        Pad::GetConfig()->GetController(0)->SetInputOverrideFunction(
+            [](std::string_view group, std::string_view control,
+               ControlState /*state*/) -> std::optional<ControlState> {
+              if (!g_rt_host.rp_host.input_state)
+                return std::nullopt;   // direct C-API mode (Slice J): no host input, unchanged
+              rp_input_state in{};
+              g_rt_host.rp_host.input_state(g_rt_host.rp_host.host, 0, &in);
+              auto key = [&](int vk) { return in.keys[vk] != 0; };
+              auto btn = [&](int bit) { return ((in.pad_buttons >> bit) & 1u) != 0; };
+              auto ax  = [&](int i) { return in.pad_axes[i] / 32767.0; };
+              if (group == "Buttons") {
+                if (control == "A")     return (btn(RP_PAD_A)     || key('K'))       ? 1.0 : 0.0;
+                if (control == "B")     return (btn(RP_PAD_B)     || key('J'))       ? 1.0 : 0.0;
+                if (control == "X")     return (btn(RP_PAD_X)     || key('L'))       ? 1.0 : 0.0;
+                if (control == "Y")     return (btn(RP_PAD_Y)     || key('I'))       ? 1.0 : 0.0;
+                if (control == "Z")     return (btn(RP_PAD_SELECT)|| key('U'))       ? 1.0 : 0.0;
+                if (control == "Start") return (btn(RP_PAD_START) || key(VK_RETURN)) ? 1.0 : 0.0;
+                return std::nullopt;
+              }
+              if (group == "Main Stick") {
+                double x = ax(RP_AXIS_LEFT_X), y = ax(RP_AXIS_LEFT_Y);
+                if (key(VK_LEFT))  x = -1.0;
+                if (key(VK_RIGHT)) x =  1.0;
+                if (key(VK_DOWN))  y = -1.0;
+                if (key(VK_UP))    y =  1.0;
+                if (control == "X") return std::clamp(x, -1.0, 1.0);
+                if (control == "Y") return std::clamp(y, -1.0, 1.0);
+                return std::nullopt;
+              }
+              if (group == "C-Stick") {
+                double x = ax(RP_AXIS_RIGHT_X), y = ax(RP_AXIS_RIGHT_Y);
+                if (control == "X") return std::clamp(x, -1.0, 1.0);
+                if (control == "Y") return std::clamp(y, -1.0, 1.0);
+                return std::nullopt;
+              }
+              if (group == "Triggers") {
+                double lt = ax(RP_AXIS_LEFT_TRIGGER), rt = ax(RP_AXIS_RIGHT_TRIGGER);
+                if (control == "L")        return (btn(RP_PAD_L) || lt > 0.5) ? 1.0 : 0.0;
+                if (control == "R")        return (btn(RP_PAD_R) || rt > 0.5) ? 1.0 : 0.0;
+                if (control == "L-Analog") return btn(RP_PAD_L) ? 1.0 : lt;
+                if (control == "R-Analog") return btn(RP_PAD_R) ? 1.0 : rt;
+                return std::nullopt;
+              }
+              if (group == "D-Pad") {
+                if (control == "Up")    return btn(RP_PAD_DPAD_UP)    ? 1.0 : 0.0;
+                if (control == "Down")  return btn(RP_PAD_DPAD_DOWN)  ? 1.0 : 0.0;
+                if (control == "Left")  return btn(RP_PAD_DPAD_LEFT)  ? 1.0 : 0.0;
+                if (control == "Right") return btn(RP_PAD_DPAD_RIGHT) ? 1.0 : 0.0;
+                return std::nullopt;
+              }
+              return std::nullopt;
+            });
+        input_override_installed = true;
+      }
+      MSG msg;
+      while (PeekMessageW(&msg, nullptr, 0, 0, PM_REMOVE))
+      {
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+      }
+      Core::HostDispatchJobs(system);
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    // Stop pulling BEFORE Core::Shutdown destroys the SoundStream/Mixer.
+    if (audio_thread.joinable())
+      audio_thread.join();
+    if (input_override_installed && Pad::IsInitialized() && Pad::GetConfig() &&
+        Pad::GetConfig()->GetControllerCount() > 0)
+      Pad::GetConfig()->GetController(0)->ClearInputOverrideFunction();
+    Core::Stop(system);
+    Core::Shutdown(system);
+  }
+
+  g_np_frame_hook.reset();
+  if (hwnd)
+    DestroyWindow(hwnd);
+  UICommon::ShutdownControllers();
+  UICommon::Shutdown();
+}
+
+// Spawn the Dolphin host thread for `rom` (surfaces come from RetroParkExternalPresent, set by the
+// caller). Returns false if already running.
+bool BootDolphinThread(std::string rom)
+{
+  if (g_running.load())
+    return false;
+  g_running.store(true, std::memory_order_release);
+  g_host_thread = std::thread(HostThread, std::move(rom), std::string(), /*netplay=*/false);
+  return true;
+}
+
+// Start HostThread in netplay-armed mode: it sets up UICommon/window/config, then blocks until Dolphin's
+// netplay StartGame flow posts a boot request (see the seam above). Blocks until UICommon is ready so the
+// caller can safely create the server/client and build a GameFile from `rom`.
+bool ArmNetplayThread(std::string rom)
+{
+  if (g_running.load())
+    return false;
+  g_netplay_rom = std::move(rom);
+  g_netplay_armed.store(true, std::memory_order_release);
+  g_np_host_ready.store(false, std::memory_order_release);
+  g_running.store(true, std::memory_order_release);
+  g_host_thread = std::thread(HostThread, std::string(), std::string(), /*netplay=*/true);
+  // Wait (bounded) for UICommon::Init + window setup to finish before returning.
+  for (int i = 0; i < 500 && !g_np_host_ready.load(std::memory_order_acquire); ++i)
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+  return g_np_host_ready.load(std::memory_order_acquire);
+}
+
+void StopDolphinThread()
+{
+  g_running.store(false, std::memory_order_release);
+  // Wake a netplay HostThread that may still be waiting for a boot request (stop before a game armed).
+  {
+    std::lock_guard<std::mutex> lk(g_boot_mutex);
+    g_boot_request.reset();
+  }
+  g_boot_cv.notify_all();
+  if (g_host_thread.joinable())
+    g_host_thread.join();
+  g_netplay_armed.store(false, std::memory_order_release);
+  g_np_host_ready.store(false, std::memory_order_release);
+  // Drop the last snapshot so a stop->start of a different game can't hand back the previous game's
+  // state; also frees the ~94 MB buffer.
+  g_state_size = 0;
+  g_state_buf = {};
+}
+}  // namespace
+
+// ---- Slice O: RetroPark drives Dolphin's OWN built-in netplay (headless). ----
+// A headless NetPlayUI (mirrors DolphinQt/NetPlay/NetPlayDialog.cpp behaviors, but no Qt): the
+// display/chat/digest/GBA/Wii-sync methods are no-ops; the connection/state callbacks update atomic
+// flags the vehicle exposes via rp_dolphin_netplay_status. Task 1 only CONNECTs peers — BootGame /
+// OnMsgStartGame / FindGameFile get minimal placeholder bodies (Task 2 implements the boot flow).
+namespace
+{
+std::atomic<int> g_np_connected{0}, g_np_desynced{0};   // g_np_started lives in the boot seam above
+std::atomic<uint32_t> g_np_players{0};
+
+// Guards the server/client unique_ptrs. Netplay boot introduces the emulation/CPU + client network
+// threads, so rp_dolphin_netplay_status (test/main thread) must not read g_netplay_client while
+// rp_dolphin_netplay_stop tears it down. A plain mutex around the pointer touches is enough; the netplay
+// getters it calls (IsConnected/GetPlayers) don't re-enter this lock.
+std::mutex g_netplay_ptr_mutex;
+
+std::unique_ptr<NetPlay::NetPlayServer> g_netplay_server;
+std::unique_ptr<NetPlay::NetPlayClient> g_netplay_client;
+
+class RpNetPlayUI final : public NetPlay::NetPlayUI
+{
+public:
+  // The netplay client hands us the ROM path + a net-synced BootSessionData (its NetSettings already
+  // baked in). We own the window/WSI on HostThread, so — mirroring the Qt dialog's m_start_game_callback
+  // seam — we don't boot here; we post the request and let the netplay-armed HostThread run BootCore.
+  void BootGame(const std::string& filename,
+                std::unique_ptr<BootSessionData> boot_session_data) override
+  {
+    {
+      std::lock_guard<std::mutex> lk(g_boot_mutex);
+      g_boot_request.emplace();
+      g_boot_request->filename = filename;
+      g_boot_request->bsd = std::move(boot_session_data);
+    }
+    g_boot_cv.notify_all();
+  }
+  void StopGame() override {}
+  bool IsHosting() const override { return g_netplay_server != nullptr; }
+
+  void Update() override {}
+  void AppendChat(const std::string&) override {}
+
+  void OnMsgChangeGame(const NetPlay::SyncIdentifier& id, const std::string&) override
+  {
+    m_current_id = id;
+  }
+  void OnMsgChangeGBARom(int, const NetPlay::GBAConfig&) override {}
+  // Server signalled game start. Mirror NetPlayDialog::OnMsgStartGame: kick the client's StartGame, which
+  // builds the net-synced BootSessionData and calls our BootGame. Runs on the client's network thread.
+  void OnMsgStartGame() override
+  {
+    if (g_netplay_client)
+    {
+      if (const auto game = FindGameFile(m_current_id, nullptr))
+        g_netplay_client->StartGame(game->GetFilePath());
+    }
+  }
+  void OnMsgStopGame() override {}
+  void OnMsgPowerButton() override {}
+  void OnPlayerConnect(const std::string&) override { g_np_players.fetch_add(1); }
+  void OnPlayerDisconnect(const std::string&) override
+  {
+    if (g_np_players.load() > 0)
+      g_np_players.fetch_sub(1);
+  }
+  void OnPadBufferChanged(u32) override {}
+  void OnHostInputAuthorityChanged(bool) override {}
+  void OnDesync(u32, const std::string&) override { g_np_desynced.store(1); }
+  void OnConnectionLost() override { g_np_connected.store(0); }
+  void OnConnectionError(const std::string&) override {}
+  void OnTraversalError(Common::TraversalClient::FailureReason) override {}
+  void OnTraversalStateChanged(Common::TraversalClient::State) override {}
+  void OnGameStartAborted() override {}
+  void OnGolferChanged(bool, const std::string&) override {}
+  void OnTtlDetermined(u8) override {}
+
+  bool IsRecording() override { return false; }
+  // Headless has no game list to search; both peers armed the identical ROM path (g_netplay_rom), so we
+  // build the GameFile straight from it. The optional comparison lets callers (e.g. the host's
+  // SetupNetSettings) confirm it matches the requested SyncIdentifier.
+  std::shared_ptr<const UICommon::GameFile>
+  FindGameFile(const NetPlay::SyncIdentifier& id, NetPlay::SyncIdentifierComparison* cmp) override
+  {
+    if (g_netplay_rom.empty())
+      return nullptr;
+    auto game = std::make_shared<UICommon::GameFile>(g_netplay_rom);
+    if (!game->IsValid())
+      return nullptr;
+    if (cmp)
+      *cmp = game->CompareSyncIdentifier(id);
+    return game;
+  }
+  std::string FindGBARomPath(const std::array<u8, 20>&, std::string_view, int) override { return {}; }
+  void ShowGameDigestDialog(const std::string&) override {}
+  void SetGameDigestProgress(int, int) override {}
+  void SetGameDigestResult(int, const std::string&) override {}
+  void AbortGameDigest() override {}
+
+  void OnIndexAdded(bool, std::string) override {}
+  void OnIndexRefreshFailed(std::string) override {}
+
+  void ShowChunkedProgressDialog(const std::string&, u64, std::span<const int>) override {}
+  void HideChunkedProgressDialog() override {}
+  void SetChunkedProgress(int, u64) override {}
+
+  void SetHostWiiSyncData(std::vector<u64>, std::string) override {}
+
+  NetPlay::SyncIdentifier m_current_id{};
+};
+
+RpNetPlayUI g_netplay_ui;
+}  // namespace
+
+extern "C"
+{
+  // Arm netplay: record the local ROM and start the netplay-armed HostThread (which will wait for the
+  // netplay StartGame flow to boot it). Both host and joiner call this before host()/join(); the ROM path
+  // is identical on both peers, so both build the same SyncIdentifier and boot the same game.
+  __declspec(dllexport) int rp_dolphin_netplay_arm(const char* rom)
+  {
+    return ArmNetplayThread(std::string(rom ? rom : "")) ? 0 : 1;
+  }
+
+  __declspec(dllexport) int rp_dolphin_netplay_host(uint16_t port)
+  {
+    std::lock_guard<std::mutex> lk(g_netplay_ptr_mutex);
+    g_netplay_server = std::make_unique<NetPlay::NetPlayServer>(
+        port, /*forward_port=*/false, &g_netplay_ui, NetPlay::NetTraversalConfig{});
+    if (!g_netplay_server || !g_netplay_server->is_connected)
+    {
+      g_netplay_server.reset();
+      return 1;
+    }
+    // Mirror DolphinQt: hosting also runs a local client connected to the server over loopback. The
+    // client is what carries the player list (NetPlayServer notifies no UI directly — OnPlayerConnect
+    // fires on the CLIENT), so the host must be a participant to observe the joiner. rp_..._status
+    // reads the live count from this client's GetPlayers().
+    g_netplay_client = std::make_unique<NetPlay::NetPlayClient>(
+        std::string("127.0.0.1"), port, &g_netplay_ui, "player1", NetPlay::NetTraversalConfig{});
+    if (!g_netplay_client || !g_netplay_client->IsConnected())
+    {
+      g_netplay_client.reset();
+      g_netplay_server.reset();
+      return 1;
+    }
+    g_np_connected.store(1);
+    return 0;
+  }
+
+  __declspec(dllexport) int rp_dolphin_netplay_join(const char* ip, uint16_t port)
+  {
+    std::lock_guard<std::mutex> lk(g_netplay_ptr_mutex);
+    g_netplay_client = std::make_unique<NetPlay::NetPlayClient>(
+        std::string(ip ? ip : ""), port, &g_netplay_ui, "player2", NetPlay::NetTraversalConfig{});
+    if (!g_netplay_client)
+      return 1;
+    const bool connected = g_netplay_client->IsConnected();
+    g_np_connected.store(connected ? 1 : 0);
+    return connected ? 0 : 1;
+  }
+
+  // Host arms the game: identify the ROM by SyncIdentifier and drive Dolphin's own start sequence
+  // (ChangeGame + RequestStartGame). Mirrors NetPlayDialog game-select + OnStart. Both peers then receive
+  // OnMsgStartGame and boot through the bridge above.
+  __declspec(dllexport) int rp_dolphin_netplay_start()
+  {
+    std::lock_guard<std::mutex> lk(g_netplay_ptr_mutex);
+    if (!g_netplay_server)
+      return 1;
+    UICommon::GameFile game(g_netplay_rom);
+    if (!game.IsValid())
+      return 2;
+    if (!g_netplay_server->ChangeGame(game.GetSyncIdentifier(), "netplay"))
+      return 3;
+    return g_netplay_server->RequestStartGame() ? 0 : 4;
+  }
+
+  __declspec(dllexport) void rp_dolphin_netplay_status(int* c, int* s, int* d, uint32_t* p,
+                                                       uint32_t* frame)
+  {
+    uint32_t players = 0;
+    {
+      std::lock_guard<std::mutex> lk(g_netplay_ptr_mutex);
+      if (g_netplay_client)
+      {
+        g_np_connected.store(g_netplay_client->IsConnected() ? 1 : 0);
+        players = static_cast<uint32_t>(g_netplay_client->GetPlayers().size());
+      }
+    }
+    g_np_players.store(players);
+    if (c)
+      *c = g_np_connected.load();
+    if (s)
+      *s = g_np_started.load();
+    if (d)
+      *d = g_np_desynced.load();
+    if (p)
+      *p = players;
+    if (frame)
+      *frame = g_np_frame.load(std::memory_order_relaxed);
+  }
+
+  __declspec(dllexport) void rp_dolphin_netplay_stop()
+  {
+    // Unblock the CPU thread from GetNetPads FIRST: StopGame() tears down the client's net-input pump, so a
+    // CPU thread parked waiting for the next frame's pads wakes cleanly instead of racing StopDolphinThread's
+    // Core::Stop (closes a near-simultaneous-stop hang window). Guarded by the pointer mutex; the emu-thread
+    // join and pointer teardown below keep their existing order.
+    {
+      std::lock_guard<std::mutex> lk(g_netplay_ptr_mutex);
+      if (g_netplay_client)
+        g_netplay_client->StopGame();
+    }
+    // Stop emulation (joins the netplay HostThread, which runs Core::Stop/Shutdown and disables netplay on
+    // the CPU thread) so the CPU/network threads are no longer using the client when we free it.
+    // StopDolphinThread is a no-op when nothing was armed (e.g. the connect-only test).
+    StopDolphinThread();
+    std::lock_guard<std::mutex> lk(g_netplay_ptr_mutex);
+    g_netplay_client.reset();
+    g_netplay_server.reset();
+    g_np_connected.store(0);
+    g_np_started.store(0);
+    g_np_desynced.store(0);
+    g_np_players.store(0);
+    g_np_frame.store(0, std::memory_order_relaxed);
+  }
+}
+
+// ---- Slice J direct-handoff C API (used by the standalone test). ----
+extern "C"
+{
+  __declspec(dllexport) int rp_dolphin_boot(const uint8_t* device_uuid, void* image_handle,
+                                            void* timeline_handle, uint32_t width, uint32_t height,
+                                            const char* rom_path, const char* user_dir)
+  {
+    (void)user_dir;
+    auto& ext = Vulkan::GetRetroParkExternalPresent();
+    ext.enabled = true;
+    std::memcpy(ext.device_uuid, device_uuid, 16);
+    ext.image_handle = image_handle;
+    ext.timeline_handle = timeline_handle;
+    ext.width = width;
+    ext.height = height;
+    // Single-image boot path: only slot 0 (image_handle); slot_count stays 1 -> the external swapchain
+    // reduces to the old lock-step. No host ring, so the Vulkan present must NOT call submit_frame — it
+    // only publishes GetRetroParkLastSignaledValue (which rp_dolphin_last_signal returns).
+    ext.slot_count = 1;
+    ext.consume_timeline_handle = nullptr;  // single-image lock-step: wait the produce timeline directly
+    for (uint32_t i = 0; i < Vulkan::RetroParkExternalPresent::kMaxSlots; ++i)
+      ext.image_handles[i] = nullptr;
+    g_rt_host.rp_host = rp_host_iface{};  // C-API mode: report via the global, not submit_frame
+    Vulkan::GetRetroParkCoreHost() = Vulkan::RetroParkCoreHost{};  // disabled: no submit_frame
+    return BootDolphinThread(std::string(rom_path ? rom_path : "")) ? 0 : 1;
+  }
+
+  __declspec(dllexport) uint64_t rp_dolphin_last_signal()
+  {
+    return Vulkan::GetRetroParkLastSignaledValue().load(std::memory_order_acquire);
+  }
+
+  // Honest emulation-speed clock: total presented frames since boot. frames/wall-second / ~59.94 =
+  // real-time fraction (the audio puller pulls at wall-clock, so it is NOT a speed signal). Not ABI.
+  __declspec(dllexport) uint64_t rp_dolphin_present_count()
+  {
+    return g_present_total.load(std::memory_order_relaxed);
+  }
+
+  __declspec(dllexport) void rp_dolphin_stop() { StopDolphinThread(); }
+}
+
+// ---- Slice K: dolphin_present as a loadable RetroPark presenting core (rp_core_abi). ----
+namespace
+{
+struct DolphinCore
+{
+  rp_host_iface host{};
+  std::string rom;
+};
+
+void dp_get_info(rp_core_info* out)
+{
+  out->abi_version = RETROPARK_ABI_VERSION;
+  out->type = RP_CORE_PRESENTING;
+  out->graphics_api = RP_GFX_VULKAN;
+  out->id = "dolphin_present";
+}
+rp_core* dp_create(const rp_host_iface* host)
+{
+  auto* c = new DolphinCore();
+  c->host = *host;
+  return reinterpret_cast<rp_core*>(c);
+}
+void dp_destroy(rp_core* core)
+{
+  StopDolphinThread();
+  delete reinterpret_cast<DolphinCore*>(core);
+}
+rp_result dp_load_content(rp_core* core, const char* path)
+{
+  reinterpret_cast<DolphinCore*>(core)->rom = path ? path : "";
+  return RP_OK;
+}
+rp_result dp_set_surfaces(rp_core* core, const rp_surface_set* set)
+{
+  if (!set || set->count < 1)
+    return RP_ERR_BAD_ARG;
+  auto* c = reinterpret_cast<DolphinCore*>(core);
+  auto& ext = Vulkan::GetRetroParkExternalPresent();
+  // Mid-run surface realloc is UNSUPPORTED in external mode: the imported images + timelines are bound into
+  // the SwapChain once at boot and never re-imported, so swapping handles under a running game would leave
+  // Dolphin rendering into freed memory. The Runtime only calls set_surfaces in the Created state (before
+  // start/boot); this guard asserts that invariant instead of silently corrupting.
+  assert(!g_running.load(std::memory_order_acquire) &&
+         "RetroPark: set_surfaces after boot is unsupported (external images/timelines are boot-time only)");
+  ext.enabled = true;
+  std::memcpy(ext.device_uuid, set->device_uuid, 16);
+  // Capture ALL slots the host exported (free-run round-robin); slot 0 also aliases image_handle
+  // for the single-image boot path.
+  uint32_t n = set->count;
+  if (n > Vulkan::RetroParkExternalPresent::kMaxSlots)
+    n = Vulkan::RetroParkExternalPresent::kMaxSlots;
+  ext.slot_count = n;
+  for (uint32_t i = 0; i < n; ++i)
+    ext.image_handles[i] = set->surfaces[i].shared_handle;
+  ext.image_handle = set->surfaces[0].shared_handle;
+  ext.timeline_handle = set->sync_handle;
+  // Consume timeline: the host's one-directional back-pressure channel (ABI v6). When the host provides it
+  // (multi-slot), the SwapChain waits it before slot reuse; null keeps the single-timeline lock-step.
+  ext.consume_timeline_handle = set->consume_sync_handle;
+  ext.width = set->surfaces[0].width;
+  ext.height = set->surfaces[0].height;
+  g_rt_host.rp_host = c->host;  // rp_core mode: audio puller + input override read from here
+  g_rt_host.rp_generation = set->surfaces[0].generation;
+
+  // Direct present: the Vulkan backend reports each rendered frame to the host ring from
+  // PresentBackbuffer. Hand it the submit_frame callback + host handle + generation via the opaque
+  // Vulkan-backend global (no ABI-header dependency in the video backend). enabled gates the call.
+  auto& core_host = Vulkan::GetRetroParkCoreHost();
+  core_host.submit_frame =
+      reinterpret_cast<Vulkan::RetroParkCoreHost::SubmitFrameFn>(c->host.submit_frame);
+  core_host.host = c->host.host;
+  core_host.generation = set->surfaces[0].generation;
+  core_host.enabled = (c->host.submit_frame != nullptr);
+  return RP_OK;
+}
+rp_result dp_start(rp_core* core)
+{
+  auto* c = reinterpret_cast<DolphinCore*>(core);
+  if (c->rom.empty())
+    return RP_ERR_INTERNAL;
+  // Netplay-armed path (harness --core + --netplay-*): rp_dolphin_netplay_arm already started the
+  // netplay HostThread (g_running=true), and the boot is driven by Dolphin's own netplay StartGame ->
+  // BootGame flow — NOT by us. Booting again here would hit BootDolphinThread's "already running" guard,
+  // return an error, and make Runtime::load_content bail BEFORE open_audio (silent session, loader stuck
+  // in Created). Succeed instead so the Runtime proceeds to open_audio and marks the loader Started.
+  if (g_netplay_armed.load(std::memory_order_acquire))
+    return RP_OK;
+  return BootDolphinThread(c->rom) ? RP_OK : RP_ERR_DEVICE;
+}
+rp_result dp_stop(rp_core*)
+{
+  StopDolphinThread();
+  return RP_OK;
+}
+void dp_get_av_info(rp_core*, rp_av_info* out)
+{
+  // Dolphin's SoundStream mixer runs at a fixed 48 kHz (we force it there after the Null backend zeroes
+  // it); the producer pulls that mix and forwards interleaved stereo s16, so the host opens XAudio2 at
+  // this rate. Geometry is unused (presenting core, not driven-validated). Constant to avoid racing the
+  // async boot — the Runtime queries this right after start(), before the SoundStream may exist.
+  out->fps = 0.0;
+  out->sample_rate = 48000.0;
+  out->base_width = 0; out->base_height = 0; out->max_width = 0; out->max_height = 0;
+  out->pixel_format = 0;
+}
+
+// Heavyweight: this performs a FULL emulation-pausing save (tens of MB, seconds-long DoState walk), so
+// it must NOT be polled per-frame (relevant once Dolphin rewind/netplay lands, which capture per frame).
+size_t dp_serialize_size(rp_core*)
+{
+  // g_running is set before Dolphin's async boot finishes; also require the Core to actually be Running
+  // (Core::IsRunning is true only for Running/Paused, not Starting) so a pre-boot call can't race boot
+  // by running State::SaveToBuffer->DoState inline on the caller thread. Cleanly returns 0 before boot.
+  if (!g_running.load(std::memory_order_acquire) || !Core::IsRunning(Core::System::GetInstance()))
+    return 0;   // not booted -> Runtime::save_state reports RP_ERR_UNSUPPORTED
+  g_state_size = State::SaveToBufferOnCPUThread(Core::System::GetInstance(), g_state_buf);
+  return g_state_size;
+}
+rp_result dp_serialize(rp_core*, void* data, size_t size)
+{
+  if (!data || g_state_size == 0 || size < g_state_size)
+    return RP_ERR_BAD_ARG;
+  std::memcpy(data, g_state_buf.data(), g_state_size);   // snapshot captured at the serialize_size call
+  return RP_OK;
+}
+rp_result dp_unserialize(rp_core*, const void* data, size_t size)
+{
+  // Same pre-boot guard as dp_serialize_size: without a Running Core, LoadFromBuffer->DoState would run
+  // inline on the caller thread and race the async boot.
+  if (!g_running.load(std::memory_order_acquire) || !Core::IsRunning(Core::System::GetInstance()) ||
+      !data || size == 0)
+    return RP_ERR_BAD_ARG;
+  std::vector<u8> tmp(size);
+  std::memcpy(tmp.data(), data, size);
+  return State::LoadFromBufferOnCPUThread(Core::System::GetInstance(), std::span<u8>(tmp.data(), tmp.size()))
+             ? RP_OK : RP_ERR_INTERNAL;
+}
+
+// ---- Core options (Task A1): internal-resolution + aspect-ratio. Renderer is locked to Vulkan and vsync
+// is host-owned, so only these two GC-relevant settings are exposed. ----
+const char* dp_core_options_json(rp_core*)
+{
+  static const char* kJson =
+      "[{\"key\":\"dolphin_internal_resolution\",\"desc\":\"Internal Resolution\",\"info\":\"\",\"default\":\"1\","
+        "\"values\":[{\"value\":\"1\",\"label\":\"Native (640x480)\"},{\"value\":\"2\",\"label\":\"2x (1280x960)\"},"
+        "{\"value\":\"3\",\"label\":\"3x\"},{\"value\":\"4\",\"label\":\"4x\"},{\"value\":\"5\",\"label\":\"5x\"},"
+        "{\"value\":\"6\",\"label\":\"6x\"}]},"
+       "{\"key\":\"dolphin_aspect_ratio\",\"desc\":\"Aspect Ratio\",\"info\":\"\",\"default\":\"0\","
+        "\"values\":[{\"value\":\"0\",\"label\":\"Auto\"},{\"value\":\"1\",\"label\":\"Force 16:9\"},"
+        "{\"value\":\"2\",\"label\":\"Force 4:3\"},{\"value\":\"3\",\"label\":\"Stretch\"}]}]";
+  return kJson;
+}
+const char* dp_core_option_get(rp_core*, const char* key)
+{
+  if (!key)
+    return nullptr;
+  std::lock_guard<std::mutex> lk(g_dp_options_mtex);
+  auto it = g_dp_options.find(key);
+  if (it != g_dp_options.end())
+    return it->second.c_str();  // stable per-key map entry (node-based); no shared scratch to clobber
+                                // across keys (the lifetime bug the shim's whole-branch review fixed).
+  if (!strcmp(key, "dolphin_internal_resolution"))
+    return "1";
+  if (!strcmp(key, "dolphin_aspect_ratio"))
+    return "0";
+  return nullptr;  // unknown key
+}
+rp_result dp_core_option_set(rp_core*, const char* key, const char* value)
+{
+  if (!key || !value)
+    return RP_ERR_BAD_ARG;
+  if (strcmp(key, "dolphin_internal_resolution") && strcmp(key, "dolphin_aspect_ratio"))
+    return RP_ERR_NOT_FOUND;
+  {
+    std::lock_guard<std::mutex> lk(g_dp_options_mtex);
+    g_dp_options[key] = value;
+  }
+  // Live apply on the CPU thread if the core is actually running (mirror dp_serialize's guard); otherwise
+  // the boot config block applies it. A running config change triggers Dolphin's video refresh. This tree's
+  // RunOnCPUThread is fire-and-forget off the CPU thread, so a promise/future waits for the apply (the same
+  // pattern State::SaveToBufferOnCPUThread uses in dp_serialize_size).
+  if (g_running.load(std::memory_order_acquire) && Core::IsRunning(Core::System::GetInstance()))
+  {
+    std::string k = key, v = value;
+    std::promise<void> done;
+    Core::RunOnCPUThread(
+        Core::System::GetInstance(),
+        [&] {
+          ApplyDolphinOptionToConfig(k, v);
+          done.set_value();
+        });
+    done.get_future().wait();
+  }
+  return RP_OK;
+}
+
+const rp_core_abi kAbi = {
+    RETROPARK_ABI_VERSION, dp_get_info,    dp_create,        dp_destroy,   dp_set_surfaces,
+    dp_start,              dp_stop,        dp_get_av_info,   nullptr,      dp_serialize_size,
+    dp_serialize,          dp_unserialize, dp_load_content,
+    dp_core_options_json,  dp_core_option_get, dp_core_option_set};
+}  // namespace
+
+extern "C" __declspec(dllexport) const rp_core_abi* rp_get_core_abi(void) { return &kAbi; }
